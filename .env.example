# Paystack configuration
PAYSTACK_SECRET_KEY=your_paystack_secret_key
# or
PAYSTACK_SECRET=your_paystack_secret_key
PAYSTACK_PUBLIC=your_paystack_public_key

# Optional frontend URL fallbacks
FRONTEND_URL=https://your-frontend-domain.com
APP_URL=https://your-frontend-domain.com

# AllenDataHub fulfillment API (server-side only)
ALLENDATAHUB_API_KEY=up_live_your_key
ALLENDATAHUB_BASE_URL=https://allendatahub.onrender.com
